{
  "description": "Decision Forensics (Ghost Protocol): action logging via PostToolUse, retrospective every N actions",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PLUGIN_ROOT/scripts/post-record.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
