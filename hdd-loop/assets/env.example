# Direct OpenRouter Dreamer
OPENROUTER_API_KEY=sk-or-v1-replace-me
HDD_DREAMER_TRANSPORT=openrouter
HDD_DREAMER_MODEL=deepseek/deepseek-r1
HDD_DREAMER_MAX_TOKENS=16384
# HDD_DREAMER_TEMPERATURE=0.7
# HDD_HTTP_REFERER=https://example.invalid/hdd-loop
# HDD_APP_TITLE=hdd-loop

# Optional external critic. Leave unset to let the host agent act as Red Pen.
# HDD_CRITIC_TRANSPORT=openai-compatible
# HDD_CRITIC_BASE_URL=https://provider.example/v1
# HDD_CRITIC_MODEL=critic-model
# HDD_CRITIC_API_KEY=replace-me

# Generic local OpenAI-compatible Dreamer alternative
# HDD_DREAMER_TRANSPORT=openai-compatible
# HDD_DREAMER_BASE_URL=http://127.0.0.1:8080/v1
# HDD_DREAMER_MODEL=deepseek-r1
# HDD_DREAMER_API_KEY=

# CLI adapter alternative
# HDD_DREAMER_TRANSPORT=command
# HDD_DREAMER_CMD=my-llm-cli --model deepseek-r1
